{%- comment -%}
  The publication-specific parts of one CV entry (entry.pub). Parameters: entry, part.
    part="head"  the citation for the card's .cv-head: authors (year). title. venue. The year is left out when the card shows
                 the entry's date at its right (entry.when), as the Revision 2 mockup does. The citation carries
                 id="<entry id>-title", which the card's <summary> names in aria-describedby.
    part="tags"  the tag row <p class="cv-tags"> under the citation, outside the <details>: the badge chip for now (the role,
                 "Preprint" and metric tags follow in later tasks). Nothing is drawn when there is no tag.
    part="body"  the folded material before the links: full author list (when it differs from the short one),
                 "My contribution", "Abstract"; each only when the data has it
  pub.abstract and the *_html fields are trusted sanitised HTML and are output as is; pub.year and the badge are escaped.
{%- endcomment -%}
{%- assign entry = include.entry -%}
{%- assign pub = entry.pub -%}
{%- if include.part == 'head' -%}
  {%- assign pub_title_last = pub.title_html | strip_html | strip | slice: -1 -%}
  {%- assign pub_title_stop = '.' -%}
  {%- if pub_title_last == '?' or pub_title_last == '!' or pub_title_last == '.' -%}
    {%- assign pub_title_stop = '' -%}
  {%- endif -%}
  {%- comment -%} Without the year, an author list ending in an initial ("D.") or an ellipsis takes no extra full stop. {%- endcomment -%}
  {%- assign pub_authors_last = pub.authors_short_html | strip_html | strip | slice: -1 -%}
  {%- assign pub_authors_stop = '. ' -%}
  {%- if pub.year and entry.when == blank -%}
    {%- assign pub_authors_stop = ' (' | append: pub.year | escape | append: '). ' -%}
  {%- elsif pub_authors_last == '.' or pub_authors_last == '…' -%}
    {%- assign pub_authors_stop = ' ' -%}
  {%- endif -%}
  <span
    class="cv-title cv-pub"
    {% if entry.id %}
      id="{{ entry.id | escape }}-title"
    {% endif %}
  >
    {{- pub.authors_short_html -}}
    {{- pub_authors_stop -}}
    {{- pub.title_html -}}
    {{- pub_title_stop -}}
    {%- if pub.venue_html %} {{ pub.venue_html }}.{% endif -%}
  </span>
{%- elsif include.part == 'tags' -%}
  {%- capture pub_tags -%}
    {%- if entry.badge -%}
      {%- comment -%} The text carries the meaning; the star is decoration, and the chip also differs in border and weight, not in colour alone. {%- endcomment -%}
      <span class="cv-badge"><span aria-hidden="true">★ </span>{{ entry.badge | escape }}</span>
    {%- endif -%}
  {%- endcapture -%}
  {%- assign pub_tags = pub_tags | strip -%}
  {%- if pub_tags != '' -%}
    <p class="cv-tags">{{ pub_tags }}</p>
  {%- endif -%}
{%- elsif include.part == 'body' -%}
  {%- if pub.authors_full_html and pub.authors_full_html != pub.authors_short_html -%}
    <p class="cv-authors"><b>All authors.</b> {{ pub.authors_full_html }}</p>
  {%- endif -%}
  {%- if pub.contribution_html -%}
    <p class="cv-contribution"><b>My contribution.</b> {{ pub.contribution_html }}</p>
  {%- endif -%}
  {%- if pub.abstract -%}
    <p class="cv-abstract"><b>Abstract.</b> {{ pub.abstract }}</p>
  {%- endif -%}
{%- endif -%}
