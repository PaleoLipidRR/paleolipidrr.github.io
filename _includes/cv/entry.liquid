{%- comment -%}
  One CV entry, drawn as a card. Parameters: entry (an entry of _data/cv.json), section (its section).

  Markup contract:
    <div class="cv-card" id="<entry id>">
      <div class="cv-card-head">
        <div class="cv-head">…</div>
        <span class="cv-date">when</span>             (only when the entry has a date)
      </div>
      <p class="cv-tags">…</p>                         (publications, only when there is a tag; see cv/publication.liquid)
      without folded content:  <p class="cv-links">…</p>
      with folded content:     <details class="cv-details">
                                 <summary class="cv-summary">what opens, e.g. "Abstract and links"</summary>
                                 <div class="cv-more">detail blocks, then <p class="cv-links">…</p></div>
                               </details>
    </div>
  .cv-head holds .cv-title (plus .cv-place), .cv-roles > .cv-role lines (entries made of roles have no date of their own; each
  role carries its own) and .cv-note lines. Notes are always visible: they sit in the head, outside the <details>.
  A title ending in a colon (skills lines such as "Languages:") is followed by its notes on the same line.
  Publication entries (entry.pub) take their head, their tag row and their folded abstract, contribution and full author list from
  cv/publication.liquid, and always have their links (cv/links.liquid) in the folded part. A publication with nothing to fold (no
  abstract, contribution, longer author list or links) has no <details>. Publication cards also carry data-status ("published",
  "under-review" or "report") and data-first-author ("true" or "false"), which the filter buttons of the Publications section
  (see _layouts/cv_page.liquid) read. Other entries' links stay below the head, outside any <details>, unless the entry has
  detail, when they end the folded part.
{%- endcomment -%}
{%- assign entry = include.entry -%}
{%- capture links -%}
  {% include cv/links.liquid entry=entry %}
{%- endcapture -%}
{%- assign links = links | strip -%}
{%- capture pub_body -%}
  {%- if entry.pub -%}
    {% include cv/publication.liquid entry=entry part='body' %}
  {%- endif -%}
{%- endcapture -%}
{%- assign pub_body = pub_body | strip -%}
{%- capture tags -%}
  {%- if entry.pub -%}
    {% include cv/publication.liquid entry=entry part='tags' %}
  {%- endif -%}
{%- endcapture -%}
{%- assign tags = tags | strip -%}
{%- assign has_detail = false -%}
{%- if entry.detail.size > 0 or pub_body != '' -%}
  {%- assign has_detail = true -%}
{%- endif -%}
{%- if entry.pub and links != '' -%}
  {%- assign has_detail = true -%}
{%- endif -%}
{%- assign title_text = entry.title_html | strip_html | strip -%}
{%- assign title_last = title_text | slice: -1 -%}
{%- assign inline_notes = false -%}
{%- if title_last == ':' and entry.notes_html.size > 0 -%}
  {%- assign inline_notes = true -%}
{%- endif -%}

{%- comment -%} The summary names what opens, in the order it appears: "All authors, my contribution, abstract and links". {%- endcomment -%}
{%- if has_detail -%}
  {%- capture summary_parts -%}
    {%- if entry.pub -%}
      {%- if entry.pub.authors_full_html and entry.pub.authors_full_html != entry.pub.authors_short_html -%}all authors|{%- endif -%}
      {%- if entry.pub.contribution_html -%}my contribution|{%- endif -%}
      {%- if entry.pub.abstract -%}abstract|{%- endif -%}
    {%- endif -%}
    {%- if entry.detail.size > 0 -%}details|{%- endif -%}
    {%- if links != '' -%}links|{%- endif -%}
  {%- endcapture -%}
  {%- assign summary_parts = summary_parts | split: '|' -%}
  {%- assign summary_label = summary_parts | last -%}
  {%- if summary_parts.size > 1 -%}
    {%- assign summary_label = summary_parts | pop | join: ', ' | append: ' and ' | append: summary_label -%}
  {%- endif -%}
  {%- assign summary_label = summary_label | capitalize -%}
{%- endif -%}

{%- capture head -%}
  {%- if entry.pub -%}
    {% include cv/publication.liquid entry=entry part='head' %}
  {%- else -%}
    <span class="cv-title">{{ entry.title_html }}</span>
    {%- if inline_notes %}
      <span class="cv-note cv-note-inline">{{ entry.notes_html | join: '; ' }}</span>
    {%- endif -%}
    {%- if entry.place %}
      <span class="cv-place"><span aria-hidden="true">·</span> {{ entry.place | escape }}</span>
    {%- endif -%}
  {%- endif -%}
  {%- if entry.roles.size > 0 -%}
    <span class="cv-roles">
      {%- for role in entry.roles -%}
        <span class="cv-role">
          <span class="cv-role-title">{{ role.title_html }}</span>
          {%- if role.when %} <span class="cv-role-when">{{ role.when | escape }}</span>{% endif -%}
        </span>
      {%- endfor -%}
    </span>
  {%- endif -%}
  {%- unless inline_notes -%}
    {%- for note in entry.notes_html -%}
      <span class="cv-note">{{ note }}</span>
    {%- endfor -%}
  {%- endunless -%}
{%- endcapture -%}

<div
  class="cv-card"
  {% if entry.id %}
    id="{{ entry.id | escape }}"
  {% endif %}
  {% if entry.pub %}
    data-status="{{ entry.pub.status | escape }}"
    data-first-author="{% if entry.pub.first_author %}true{% else %}false{% endif %}"
  {% endif %}
>
  <div class="cv-card-head">
    <div class="cv-head">{{ head }}</div>
    {%- if entry.when -%}
      <span class="cv-date">{{ entry.when | escape }}</span>
    {%- endif -%}
  </div>
  {{- tags -}}
  {%- if has_detail -%}
    <details class="cv-details">
      <summary class="cv-summary">{{ summary_label | escape }}</summary>
      <div class="cv-more">
        {{- pub_body -}}
        {%- for block in entry.detail -%}
          {%- case block.type -%}
            {%- when 'p' -%}
              <p>{{ block.html }}</p>
            {%- when 'ul' -%}
              <ul>
                {%- for item in block.items_html -%}
                  <li>{{ item }}</li>
                {%- endfor -%}
              </ul>
            {%- when 'table' -%}
              <div class="cv-table-wrap">
                <table class="cv-table">
                  {%- if block.columns.size > 0 -%}
                    <thead>
                      <tr>
                        {%- for column in block.columns -%}
                          <th scope="col">{{ column | escape }}</th>
                        {%- endfor -%}
                      </tr>
                    </thead>
                  {%- endif -%}
                  <tbody>
                    {%- for row in block.rows -%}
                      <tr>
                        {%- for cell in row -%}
                          <td>{{ cell }}</td>
                        {%- endfor -%}
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
          {%- endcase -%}
        {%- endfor -%}
        {{- links -}}
      </div>
    </details>
  {%- else -%}
    {{- links -}}
  {%- endif -%}
</div>
