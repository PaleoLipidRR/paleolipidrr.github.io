{%- comment -%}
  The links of one CV entry, as <p class="cv-links"> of a.cv-link; nothing is drawn when there are none. Parameter: entry.
  Order: for a publication, DOI, PDF, Project page, Code; then the entry's own links (entry.links); then the hand-kept
  links of _data/cv_links.yml for this entry id. A link whose URL starts with "/" is a site page and goes through relative_url.
  The PDF link is the PDF of the project page whose doi matches the publication's.
{%- endcomment -%}
{%- assign entry = include.entry -%}
{%- assign pub = entry.pub -%}
{%- assign project = null -%}
{%- if pub and pub.doi -%}
  {%- for candidate in site.projects -%}
    {%- comment -%}
      Normalise before comparing: the data holds a bare lowercase DOI, while a project page may write it as a bare DOI or a
      https://doi.org/ (or http://, or dx.doi.org) URL, in any case.
    {%- endcomment -%}
    {%- assign candidate_doi = candidate.doi
      | append: ''
      | strip
      | downcase
      | remove: 'https://doi.org/'
      | remove: 'http://doi.org/'
      | remove: 'https://dx.doi.org/'
      | remove: 'http://dx.doi.org/'
    -%}
    {%- if candidate_doi != '' and candidate_doi == pub.doi -%}
      {%- assign project = candidate -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign extra_links = site.data.cv_links[entry.id] -%}
{%- if pub or entry.links.size > 0 or extra_links.size > 0 -%}
  <p class="cv-links">
    {%- if pub -%}
      {%- if pub.doi -%}
        <a class="cv-link" href="https://doi.org/{{ pub.doi | escape }}">DOI<span aria-hidden="true"> →</span></a>
      {%- endif -%}
      {%- if project and project.pdf -%}
        <a class="cv-link" href="{{ '/assets/pdf/' | append: project.pdf | relative_url | escape }}">PDF<span aria-hidden="true"> →</span></a>
      {%- endif -%}
      {%- if project -%}
        <a class="cv-link" href="{{ project.url | relative_url | escape }}">Project page<span aria-hidden="true"> →</span></a>
      {%- endif -%}
      {%- if pub.code_url -%}
        <a class="cv-link" href="{{ pub.code_url | escape }}">Code<span aria-hidden="true"> →</span></a>
      {%- endif -%}
    {%- endif -%}
    {%- for link in entry.links -%}
      {%- assign first_char = link.url | slice: 0 -%}
      {%- if first_char == '/' -%}
        {%- assign link_href = link.url | relative_url -%}
      {%- else -%}
        {%- assign link_href = link.url -%}
      {%- endif -%}
      <a class="cv-link" href="{{ link_href | escape }}">
        {{- link.label | escape -}}
        <span aria-hidden="true"> →</span></a
      >
    {%- endfor -%}
    {%- for link in extra_links -%}
      {%- assign first_char = link.url | slice: 0 -%}
      {%- if first_char == '/' -%}
        {%- assign link_href = link.url | relative_url -%}
      {%- else -%}
        {%- assign link_href = link.url -%}
      {%- endif -%}
      <a class="cv-link" href="{{ link_href | escape }}">
        {{- link.label | escape -}}
        <span aria-hidden="true"> →</span></a
      >
    {%- endfor -%}
  </p>
{%- endif -%}
