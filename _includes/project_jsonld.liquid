{%- comment -%}
  JSON-LD ScholarlyArticle for project pages that describe a paper
  (rendered when the page has `bib_key` or `doi`). Optional `software:` and
  `dataset:` front-matter maps add the related SoftwareSourceCode / Dataset.
{%- endcomment -%}
{%- if page.bib_key or page.doi -%}
  {%- assign author_names = page.authors | split: ', ' -%}
  {%- capture jsonld_authors -%}
    {%- for name in author_names -%}
      {%- assign clean = name | strip -%}
      {"@type":"Person","name":{{ clean | jsonify }}
      {%- if forloop.first and site.data.socials.orcid_id -%}
        ,"identifier":"https://orcid.org/{{ site.data.socials.orcid_id }}"
      {%- endif -%}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ScholarlyArticle",
      "headline": {{ page.title | strip_html | jsonify }},
      "name": {{ page.title | strip_html | jsonify }},
      "description": {{ page.description | strip_html | jsonify }},
      "url": {{ page.url | absolute_url | jsonify }},
      "author": [{{ jsonld_authors | strip }}],
      {%- if page.year %}"datePublished": "{{ page.year }}",{% endif -%}
      {%- if page.doi and page.doi != '' %}
        "identifier": {"@type":"PropertyValue","propertyID":"DOI","value":{{ page.doi | jsonify }}},
        "sameAs": "https://doi.org/{{ page.doi }}",
      {%- endif -%}
      {%- if page.status == 'accepted' %}"creativeWorkStatus": "Accepted",{% elsif page.status == 'published' %}"creativeWorkStatus": "Published",{% endif -%}
      {%- if page.software %}
        "isBasedOn": {
          "@type": "SoftwareSourceCode",
          "name": {{ page.software.name | jsonify }},
          "codeRepository": {{ page.software.repository | jsonify }},
          "programmingLanguage": "Python",
          "identifier": "https://doi.org/{{ page.software.doi }}"
        },
      {%- endif -%}
      {%- if page.dataset %}
        "citation": {
          "@type": "Dataset",
          "name": {{ page.dataset.name | jsonify }},
          "identifier": "https://doi.org/{{ page.dataset.doi }}"
        },
      {%- endif -%}
      "isPartOf": {"@type":"Periodical","name":{{ page.venue | jsonify }}}
    }
  </script>
{%- endif -%}
